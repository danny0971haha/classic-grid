# ============================================================
# 经典网格总控 · 环境模板
# 复制为 .env 后填真实密钥；.env 永不提交仓库
# 默认 dry-run；实盘须 LIVE_CONFIRM=YES 且 DRY_RUN=0
# DRY_RUN accepts only exact 0 or 1 (unset/empty → 1). No trim, aliases, or case-fold.
# LIVE_CONFIRM accepts only exact YES (unset/empty → unset). Other values fail closed.
# ============================================================

# ---- 全局 ----
DRY_RUN=1
LIVE_CONFIRM=
# R2-A sandbox/testnet is a separate execution target. It is not live.
# Ambiguous truthy values are rejected. Do not infer sandbox from an API URL.
# EXECUTION_MODE=dry-run|sandbox|live
# EXTENDED_NETWORK=mainnet|sepolia
# SANDBOX_CONFIRM=EXTENDED_SEPOLIA_TEST_ONLY
EXECUTION_MODE=
EXTENDED_NETWORK=
SANDBOX_CONFIRM=
VENUES=extended,risex,decibel,n1,phoenix,phoenix2,nado,popdex
MARKETS=BTC
TICK_MS=15000
GRID_LEVERAGE=30
GRID_MARGIN_FRAC=0.7
GRID_HALF_BAND=3000
DASHBOARD_PORT=8088
GRID_SKIP_LEVERAGE=0
SOFT_RESUME=1

# ---- A/B 实验（EXPERIMENT_MODE=1 时覆盖各所杠杆/格数/权益）----
# 版本必须显式选择。缺省 / 0.1.0 保持 historical v0.1。
# 不支持或畸形的 EXPERIMENT_SPEC_VERSION 在 EXPERIMENT_MODE=1 时 fail closed，不会静默落到 v0.2。
# 共同包络冻结于 experiment-spec.md v0.1.0：50U / 10x / 30% / 150U / 12 格 / ±3%
EXPERIMENT_MODE=0
EXPERIMENT_SPEC_VERSION=0.1.0
EXPERIMENT_ID=
# live v0.1: grid-ab-v0.1-classic-live；填写非敏感账户标签用于 state/lock scope
EXPERIMENT_ACCOUNT_SCOPE=
EXPERIMENT_CAPITAL_USD=50
EXPERIMENT_LEVERAGE=10
EXPERIMENT_MARGIN_FRAC=0.30
EXPERIMENT_GRID_COUNT=12
EXPERIMENT_HALF_BAND_PCT=0.03
EXPERIMENT_MAX_GROSS_NOTIONAL_USD=150
EXPERIMENT_DAILY_LOSS_USD=2.5
EXPERIMENT_MAX_DRAWDOWN_USD=5
EXPERIMENT_BOUNDARY_BUFFER_PCT=0.01
# v0.2 100U engineering profile is frozen in code. These numbers are documentation only
# and cannot drift the 0.2.0 canary envelope. v0.2 live remains forbidden.
# EXPERIMENT_SPEC_VERSION=0.2.0
# EXPERIMENT_CAPITAL_USD=100
# EXPERIMENT_LEVERAGE=5
# EXPERIMENT_MARGIN_FRAC=0.30
# EXPERIMENT_GRID_COUNT=10
# EXPERIMENT_HALF_BAND_PCT=0.03
# EXPERIMENT_MAX_GROSS_NOTIONAL_USD=150
# EXPERIMENT_DAILY_LOSS_USD=5
# EXPERIMENT_MAX_DRAWDOWN_USD=10
# EXPERIMENT_BOUNDARY_BUFFER_PCT=0.01
# 硬停后填 risk-state.json 中本次 haltId；静态 YES 无效且成功后会被消费
EXPERIMENT_HALT_ACK=

# ---- Extended — https://app.extended.exchange/ ----
EXTENDED_API_KEY=
EXTENDED_STARK_PRIVATE_KEY=
EXTENDED_STARK_PUBLIC_KEY=
EXTENDED_VAULT_ID=
EXTENDED_VAULT=
EXTENDED_API_URL=https://api.starknet.extended.exchange
EXTENDED_USE_PROXY=0
EXTENDED_PROXY=
EXTENDED_LEVERAGE=
EXTENDED_ORDER_GAP_MS=

# ---- Extended Sepolia testnet credentials (sandbox only; never fall back to mainnet vars) ----
# Names only. This repository must not contain real keys. R2-A does not authorize writes.
EXTENDED_TESTNET_API_KEY=
EXTENDED_TESTNET_STARK_PRIVATE_KEY=
EXTENDED_TESTNET_STARK_PUBLIC_KEY=
EXTENDED_TESTNET_VAULT_ID=

# ---- RISEx — https://rise.trade/ ----
RISEX_ACCOUNT=
RISEX_SIGNER_KEY=
RISEX_API_URL=https://api.rise.trade
RISEX_WS_URL=wss://ws.rise.trade/ws
RISE_ORDER_GAP_MS=10500
RISE_SKIP_LEVERAGE=0
RISEX_LEVERAGE=
RISEX_HALF_BAND=

# ---- Decibel — https://app.decibel.trade/ ----
DECIBEL_ACCOUNT_PRIVATE_KEY=
DECIBEL_API_KEY=
DECIBEL_SUBACCOUNT=
DECIBEL_GAS_STATION_API_KEY=
DECIBEL_LEVERAGE=
DECIBEL_EQUITY_USD=
DECIBEL_HALF_BAND=

# ---- N1 — https://app.n1.xyz/（keypair 默认 secrets/id.json）----
N1_KEYPAIR_PATH=secrets/id.json
N1_APP_PUBLIC_KEY=
N1_API_URL=https://zo-mainnet.n1.xyz
N1_SOLANA_RPC=https://api.mainnet-beta.solana.com
N1_TRADING_ARMED=NO
N1_LEVERAGE=
N1_EQUITY_USD=
N1_HALF_BAND=

# ---- Phoenix / Phoenix2 — https://phoenix.trade/（Solana keypair）----
PHOENIX_PRIVATE_KEY=
PHOENIX_KEYPAIR_PATH=secrets/phoenix.key
PHOENIX_API_URL=https://perp-api.phoenix.trade
PHOENIX_SOLANA_RPC=https://api.mainnet-beta.solana.com
PHOENIX_ORDER_GAP_MS=800
PHOENIX_CU_LIMIT=
PHOENIX_LEVERAGE=
PHOENIX_HALF_BAND=
PHOENIX2_PRIVATE_KEY=
PHOENIX2_KEYPAIR_PATH=secrets/phoenix2.key
PHOENIX2_API_URL=
PHOENIX2_SOLANA_RPC=
PHOENIX2_LEVERAGE=
PHOENIX2_HALF_BAND=

# ---- Nado — https://nado.xyz/（Ink 链，secrets/nado.key）----
NADO_PRIVATE_KEY=
NADO_KEY_PATH=secrets/nado.key
NADO_ADDRESS=
NADO_SUBACCOUNT=
NADO_BTC_PRODUCT_ID=
NADO_INK_RPC=
NADO_ORDER_GAP_MS=200
NADO_LEVERAGE=
NADO_HALF_BAND=

# ---- PopDEX — https://app.popdex.xyz/（Morph Tachyon，secrets/popdex.key）----
POPDEX_PRIVATE_KEY=
POPDEX_KEY_PATH=secrets/popdex.key
POPDEX_ADDRESS=
POPDEX_SYMBOL=
POPDEX_EQUITY_USD=800
POPDEX_GRID_COUNT=80
POPDEX_LEVERAGE=30
POPDEX_HALF_BAND=
POPDEX_ORDER_GAP_MS=200

# ---- Telegram（可选）----
# 1) BotFather 建 bot → TELEGRAM_BOT_TOKEN
# 2) 给 bot 发消息后 getUpdates 取 chat.id → TELEGRAM_CHAT_IDS（逗号分隔）
# 3) TELEGRAM_ENABLED=true 后重启；开/平、错误、整点总览推送
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
